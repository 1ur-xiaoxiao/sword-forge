{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Sword Forge",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-DebugBuild"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Test Sword Forge",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Test"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": "$gcc"
    }
  ]
}
